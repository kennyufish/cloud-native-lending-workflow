{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/application-submitted-v1.schema.json",
  "title": "ApplicationSubmittedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "applicationId",
    "eventType",
    "schemaVersion",
    "applicantReference",
    "creditScore",
    "annualIncome",
    "requestedAmount",
    "submittedAt"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "applicationId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "APPLICATION_SUBMITTED" },
    "schemaVersion": { "const": 1 },
    "applicantReference": { "type": "string", "pattern": "^[A-Z0-9_-]+$", "maxLength": 64 },
    "creditScore": { "type": "integer", "minimum": 300, "maximum": 850 },
    "annualIncome": { "type": "number", "exclusiveMinimum": 0 },
    "requestedAmount": { "type": "number", "exclusiveMinimum": 0 },
    "submittedAt": { "type": "string", "format": "date-time" }
  }
}
